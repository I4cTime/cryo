[Unit]
Description=Cryo daemon — thermal, fan-curve and lighting engine for alienware-wmi laptops
# The alienware-wmi driver must be up before the daemon probes sysfs.
After=systemd-modules-load.service
# A slow driver load must not exhaust the restart budget.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=@PYTHON@ -m cryo.daemon.main
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
